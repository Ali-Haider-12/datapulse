{
  "name": "DataPulse Dev",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "forwardPorts": [
    3000,
    8001,
    9201
  ],
  "portsAttributes": {
    "3000": {
      "label": "Frontend",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    },
    "8001": {
      "label": "Backend API",
      "onAutoForward": "notify",
      "visibility": "public"
    },
    "9201": {
      "label": "Mock ES",
      "onAutoForward": "private",
      "visibility": "private"
    }
  },
  "postCreateCommand": "cd /workspaces/datapulse/backend && python3 -m venv .venv && . .venv/bin/activate && pip install --upgrade pip -q && pip install -q -r requirements.txt && cd /workspaces/datapulse/frontend && npm install",
  "postStartCommand": "chmod +x /workspaces/datapulse/.devcontainer/run.sh && exec bash /workspaces/datapulse/.devcontainer/run.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
